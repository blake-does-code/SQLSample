-- Step 1: Extract and segment shipment cost data by carrier, lane, and seasonality
WITH ShipmentCostData AS (
    SELECT 
        shipment_id,
        carrier_id,
        origin,
        destination,
        EXTRACT(MONTH FROM shipment_date) AS month,
        EXTRACT(YEAR FROM shipment_date) AS year,
        shipment_cost,
        -- Classify into seasons for seasonality analysis
        CASE 
            WHEN EXTRACT(MONTH FROM shipment_date) IN (12, 1, 2) THEN 'Winter'
            WHEN EXTRACT(MONTH FROM shipment_date) IN (3, 4, 5) THEN 'Spring'
            WHEN EXTRACT(MONTH FROM shipment_date) IN (6, 7, 8) THEN 'Summer'
            ELSE 'Fall'
        END AS season
    FROM shipments
    WHERE shipment_date >= CURRENT_DATE - INTERVAL '5 years'
),

-- Step 2: Aggregate shipment costs by carrier, lane, and season
AggregatedData AS (
    SELECT 
        carrier_id,
        origin,
        destination,
        season,
        COUNT(shipment_id) AS total_shipments,
        SUM(shipment_cost) AS total_cost,
        AVG(shipment_cost) AS avg_cost_per_shipment,
        MAX(shipment_cost) AS max_cost,
        MIN(shipment_cost) AS min_cost
    FROM ShipmentCostData
    GROUP BY carrier_id, origin, destination, season
),

-- Step 3: Calculate cost trends and highlight carriers with high variability
CarrierTrends AS (
    SELECT 
        carrier_id,
        origin,
        destination,
        season,
        total_shipments,
        total_cost,
        avg_cost_per_shipment,
        max_cost,
        min_cost,
        -- Calculate variability in shipment costs for insights
        (MAX(shipment_cost) - MIN(shipment_cost)) / NULLIF(AVG(shipment_cost), 0) AS cost_variability
    FROM AggregatedData
)

-- Step 4: Identify carriers with significant cost variability for targeted negotiations
SELECT 
    carrier_id,
    origin,
    destination,
    season,
    total_shipments,
    total_cost,
    avg_cost_per_shipment,
    cost_variability
FROM CarrierTrends
WHERE cost_variability > 0.2 -- Example threshold for "high variability"
ORDER BY cost_variability DESC, total_cost DESC;
