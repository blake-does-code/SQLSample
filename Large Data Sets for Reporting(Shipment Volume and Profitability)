SELECT 
    OriginCity,
    DestinationCity,
    COUNT(*) AS TotalShipments,
    SUM(ShipmentRevenue) AS TotalRevenue,
    SUM(ShipmentCost) AS TotalCost,
    SUM(ShipmentRevenue) - SUM(ShipmentCost) AS Profit,
    CAST((SUM(ShipmentRevenue) - SUM(ShipmentCost)) * 100.0 / SUM(ShipmentRevenue) AS DECIMAL(5,2)) AS ProfitMargin
FROM 
    Shipments
GROUP BY 
    OriginCity, DestinationCity
ORDER BY 
    ProfitMargin DESC;
